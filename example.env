# ==============================================================================
# CSVG Pipeline - Example Environment Configuration
# Copy this file to `.env` and fill in your real values:
#   cp example.env .env
#
# NOTE: `.env` is git-ignored and must NEVER be committed.
# This example file contains placeholders only.
# ==============================================================================

# Preferred provider: 
#   - "google" or "vertex": Native Google Cloud Vertex AI (using ADC, recommended)
#   - "gemini": Native Gemini AI Studio Developer API (using GEMINI_API_KEY)
#   - "cloud": OpenRouter endpoint (using OPENROUTER_API_KEY)
#   - "local": Local llama.cpp server (using LLAMA_CPP_URL)
PREFERRED_LLM_PROVIDER=google

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL2=gpt-4o-mini
LLM_MAX_TOKENS=8192
LLAMA_CPP_URL=http://127.0.0.1:8080
LLAMA_CPP_TIMEOUT=120
# Google Search Grounding POC (Vertex / ADC). Set RAG_GROUNDED=1 to replace the
# 5-scraper RAG crawl in build_rag_knowledge_pack with one cited googleSearch
# research call. Requires app-default creds: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=buzzdropfeed
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=1
GROUNDING_MODEL=gemini-2.5-flash
RAG_GROUNDED=0

# Narrow tool-topic synthesis (evergreen "vs / how-to / tool review / 
# enterprise tooling" candidates LLM-proposed from the day's RSS corpus).
# Each proposed topic is precision-measured against real YouTube demand;
# unmeasured or low-opportunity (< OPPORTUNITY_MIN_SCORE) synthetics are culled.
TOOL_TOPIC_SYNTHESIS=1
TOOL_TOPIC_MAX=4
OPPORTUNITY_MIN_SCORE=0.5

# ---- YouTube Data API -------------------------------------------------------
# Primary + fallback API keys (rotated on quota/429 errors).
YOUTUBE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY_FALLBACK=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY_FALLBACK2=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx
# OAuth 2.0 credentials for publishing uploads.
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Daily budget for YouTube demand-search quota (units).
YT_SEARCH_DAILY_BUDGET=9000

# ---- News / Content APIs ----------------------------------------------------
NEWSAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIRECRAWL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
MARKETAUX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPHA_VANTAGE_KEY=xxxxxxxxxxxx
INDIAN_STOCK_API_KEY=xxxxxxxxxxxx
API_NINJAS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIPHY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENOR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NASA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Stock / Image Media ----------------------------------------------------
PIXABAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAL_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Edge MCP services (Raspberry Pi audio/STT) -----------------------------
AUDIO_EDGE_URL=http://100.108.116.100:9000

# ---- Email notifications ----------------------------------------------------
NOTIFY_EMAIL_FROM=you@gmail.com
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_EMAIL_PASSWORD=xxxxxxxx xxxx xxxx xxxx
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587

# ---- Channel YPP stats (optional overrides) ---------------------------------
CHANNEL_SUBSCRIBERS=0
CHANNEL_WATCH_HOURS=0

# ---- Community Seeding & Webhook Notification config ------------------------
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxx
REDDIT_USER_AGENT=python:buzzdropfeedv2:v2.0 (by /u/YourUsername)
REDDIT_USERNAME=YourRedditAccount
REDDIT_PASSWORD=YourRedditPassword

# LinkedIn API Credentials (Optional)
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

# X / Twitter API Credentials (Optional)
X_API_KEY=xxxxxxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxx

# TikTok Publishing Credentials (Optional)
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
TIKTOK_CLIENT_KEY=xxxxxxxxxxxxxxxx

# Instagram / Meta Graph Credentials (Optional)
INSTAGRAM_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
INSTAGRAM_PAGE_ID=xxxxxxxxxxxxxxxx

# Pinterest API Credentials (Optional)
PINTEREST_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
PINTEREST_BOARD_ID=xxxxxxxxxxxxxxxx

# Telegram Broadcasting Credentials (Optional)
TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxxxxxxxx

# Medium Integration Credentials (Optional)
MEDIUM_INTEGRATION_TOKEN=xxxxxxxxxxxxxxxx

DISCORD_SEED_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_SEED_WEBHOOK_URL=https://hooks.slack.com/services/...


# Seeding auto-publish mode: 0 = webhook drafts (safe), 1 = auto-post via PRAW (risky)
SEED_AUTO_PUBLISH=0

# Active Thread Comment Seeding Bot (Reddit PRAW)
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxx
REDDIT_USERNAME=xxxxxxxxxxxxxxxx
REDDIT_PASSWORD=xxxxxxxxxxxxxxxx
REDDIT_USER_AGENT=CSVG-Bot/1.0
ACTIVE_SEEDER_WARMUP=0



# ---- Converged-plan tunables (defaults match production behavior) ----
# YouTube publish visibility: public (default) | private | unlisted
YOUTUBE_PRIVACY_STATUS=public

# Monthly ad-revenue goal + cadence that derive the per-video revenue gate
CSVG_MONTHLY_REVENUE_TARGET_USD=2000
CSVG_TARGET_DAILY_PUBLISHES=2

# Storability gate (reject direct-news topics with no documentary potential)
DOCUMENTARY_POTENTIAL_FLOOR=0.35
DOCUMENTARY_LLM_CROSSCHECK=0

# Revenue-weighted dynamic region — regional ad revenue is the highest weight
REGION_WEIGHT_REVENUE=0.55
REGION_REVENUE_REFERENCE_USD=16

# Seed relevance gate (MiniLM 0.50 floor; TF-IDF fallback 0.30)
SEED_RELEVANCE_SEMANTIC=1
SEED_RELEVANCE_THRESHOLD=0.50
SEED_RELEVANCE_TFIDF_THRESHOLD=0.30

# Cron scheduler guards (2 slots/day → up to 2 publishes)
CSVG_MAX_DAILY_PUBLISHES=4
CSVG_CRON_COOLDOWN_MIN=90
