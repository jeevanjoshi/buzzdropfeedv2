# ==============================================================================
# CSVG Pipeline - Example Environment Configuration
# Copy this file to `.env` and fill in your real values:
#   cp example.env .env
#
# NOTE: `.env` is git-ignored and must NEVER be committed.
# This example file contains placeholders only.
# ==============================================================================

# ---- LLM / AI Providers -----------------------------------------------------
# Preferred provider: "openai" | "openrouter" | "gemini" | "ollama" | ...
PREFERRED_LLM_PROVIDER=openai

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL2=gpt-4o-mini
LLM_MAX_TOKENS=8192
LLAMA_CPP_URL=http://127.0.0.1:8080
LLAMA_CPP_TIMEOUT=120

# ---- YouTube Data API -------------------------------------------------------
# Primary + fallback API keys (rotated on quota/429 errors).
YOUTUBE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY_FALLBACK=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY_FALLBACK2=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx
# OAuth 2.0 credentials for publishing uploads.
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Daily budget for YouTube demand-search quota (units).
YT_SEARCH_DAILY_BUDGET=9000

# ---- News / Content APIs ----------------------------------------------------
NEWSAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIRECRAWL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
MARKETAUX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPHA_VANTAGE_KEY=xxxxxxxxxxxx
INDIAN_STOCK_API_KEY=xxxxxxxxxxxx
API_NINJAS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GIPHY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TENOR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NASA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Stock / Image Media ----------------------------------------------------
PIXABAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FAL_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Edge MCP services (Raspberry Pi audio/STT) -----------------------------
AUDIO_EDGE_URL=http://100.108.116.100:9000

# ---- Email notifications ----------------------------------------------------
NOTIFY_EMAIL_FROM=you@gmail.com
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_EMAIL_PASSWORD=xxxxxxxx xxxx xxxx xxxx
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587

# ---- Channel YPP stats (optional overrides) ---------------------------------
CHANNEL_SUBSCRIBERS=0
CHANNEL_WATCH_HOURS=0
